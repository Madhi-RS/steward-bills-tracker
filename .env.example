# Existing PostgreSQL database. Do not commit real credentials in .env files.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bills_db?schema=public"

# Steward linked-module registration (authentication plus task integration; server-side only).
# Values are issued or confirmed when the module is registered in the Steward sandbox.
# They are server-only. Never prefix them with NEXT_PUBLIC_ or commit real values.
STEWARD_PAGE_MODE="linked"
STEWARD_CORE_URL="https://sandbox.runsteward.ai"
STEWARD_ISSUER=""
STEWARD_WEB_CLIENT_ID=""
STEWARD_REDIRECT_URI="http://localhost:3300/auth/callback"
STEWARD_SIGN_IN_ONLY="0"

# Required for signed events and server-to-Steward task/proposal calls.
# Never expose these values to the browser or commit them.
STEWARD_SIGNING_KEY=""
STEWARD_CLIENT_ID=""
STEWARD_CLIENT_SECRET=""
